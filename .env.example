# The live verification API's admin routes. Every /api/v1/admin/* request the
# dashboard makes is relayed here (src/app/api/v1/admin/[...path]/route.ts).
# Must be https:// unless it points at localhost — the relay carries the admin
# password and session cookie.
API_SERVER_URL=https://18.185.59.156/api/v1/admin

# The API box has a self-signed certificate, so it is pinned rather than
# trusted blindly. Relative to the project root.
API_SERVER_CERT=certs/aws_admin_cert.pem

# Build-time white-label settings (see src/lib/brand.ts). Rebuild after changing.
NEXT_PUBLIC_BRAND_NAME=idntory
# NEXT_PUBLIC_BRAND_LOGO=/brand/logo.png
